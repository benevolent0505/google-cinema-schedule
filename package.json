{
  "name": "google-cinema-schedule",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-manifest.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "push": "npm run build && clasp push",
    "deploy": "npm run build && clasp deploy"
  },
  "dependencies": {
    "@google/clasp": "3.4.1"
  },
  "devDependencies": {
    "@types/google-apps-script": "2.0.11",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
