{
  // Build configuration used by `npm run build`.
  // Emits plain global-scope scripts (no import/export) that Apps Script can
  // run, into `dist/`, and excludes test files.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": ["src/**/*.test.ts"]
}
